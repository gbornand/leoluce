{
  "hosting": [
    {
      "target": "main",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "calendrier/**",
        "functions/**",
        "scripts/**",
        "*adminsdk*.json",
        "*service-account*.json"
      ]
    },
    {
      "target": "calendrier",
      "public": "calendrier",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
