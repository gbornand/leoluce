rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /patients/{patientId} {
      // La connexion patient par code (sans compte) passe désormais par la Cloud Function
      // getPatientByCode (admin SDK, contourne ces règles) — plus d'accès direct non-auth.
      allow read: if request.auth != null && resource.data.orthoId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.orthoId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.orthoId == request.auth.uid;
    }

    match /sharedConfigs/{configId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        resource.data.orthoId == request.auth.uid;
    }

    match /invitations/{invId} {
      allow read: if request.auth != null && resource.data.fromOrthoId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.fromOrthoId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.fromOrthoId == request.auth.uid;
    }

    match /wordLists/{listId} {
      allow read: if request.auth != null && resource.data.teacherId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.teacherId == request.auth.uid;
    }

    match /connLogs/{logId} {
      // Créé par l'élève authentifié lui-même ; lu par lui-même ou par son ortho ;
      // seule mise à jour permise = durationMin (posé à la déconnexion).
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null &&
        (resource.data.teacherId == request.auth.uid || resource.data.userId == request.auth.uid);
      allow update: if request.auth != null && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['durationMin']);
      allow delete: if false;
    }

    match /meta/{doc} {
      allow read, write: if request.auth != null;
    }

    // ═══════════════════════════════════════
    // CALENDRIER FAMILIAL D'ANNIVERSAIRES (feature isolée, ajoutée le 2026-07-25)
    // Appartenance = existence d'un doc bdayUsers/{uid}, pas une liste d'UID en dur.
    // ═══════════════════════════════════════
    match /bdayEntries/{entryId} {
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/bdayUsers/$(request.auth.uid));
      // ownerUid est un simple tag d'attribution (alerte/couleur), pas une frontière de
      // permission — n'importe lequel des 4 peut créer une entrée sans rattachement
      // (ownerUid == null) ou rattachée à n'importe quel membre.
      allow create: if request.auth != null &&
        exists(/databases/$(database)/documents/bdayUsers/$(request.auth.uid));
      // Toute entrée est modifiable/supprimable par n'importe quel membre de la famille,
      // quelle que soit sa catégorie ou son propriétaire (décision explicite Géraldine).
      allow update, delete: if request.auth != null &&
        exists(/databases/$(database)/documents/bdayUsers/$(request.auth.uid));
    }

    match /bdayUsers/{uid} {
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/bdayUsers/$(request.auth.uid));
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /bdayImportLog/{importId} {
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/bdayUsers/$(request.auth.uid));
    }

    // ═══════════════════════════════════════
    // ANGLAIS LUCIE (feature isolée, ajoutée le 2026-11-13) — outil mono-utilisateur,
    // accès restreint à l'uid de Lucie (même constante que DIRECT_FAMILY_UIDS côté functions).
    // ═══════════════════════════════════════
    function isLucieAnglais() {
      return request.auth != null && request.auth.uid == "BmPJ62Hhb0V572vQgzwzybbnU8s2";
    }

    match /coursAnglais/{id} {
      allow read: if isLucieAnglais();
      allow write: if isLucieAnglais();
    }

    match /exercicesAnglais/{id} {
      allow read: if isLucieAnglais();
      allow write: if isLucieAnglais();
    }

    match /progressionAnglais/{id} {
      allow read: if isLucieAnglais();
      allow write: if isLucieAnglais();
    }

    match /reponsesAnglais/{id} {
      allow read, create: if isLucieAnglais();
      allow update, delete: if false;
    }

    match /seancesAnglais/{id} {
      allow read: if isLucieAnglais();
      allow write: if isLucieAnglais();
    }

    match /chansonsAnglais/{id} {
      allow read: if isLucieAnglais();
      allow write: if isLucieAnglais();
    }

  }
}
